# Copy to android/key.properties and fill in.
# DO NOT commit the real key.properties — it's in .gitignore.
#
# Generate the keystore once:
#   keytool -genkey -v -keystore ~/paranormal-release.keystore \
#     -alias paranormal -keyalg RSA -keysize 2048 -validity 10000

storeFile=/Users/work/paranormal-release.keystore
storePassword=CHANGE_ME
keyAlias=paranormal
keyPassword=CHANGE_ME
